// Prisma schema — NEXOR V1
// Documentacion completa: README_DATABASE.md
// Patron multi-tenancy: base de datos compartida + Row-Level Security por tenant_id
//
// ─── APROBACION HU-012 ────────────────────────────────────────────────────────
// Schema revisado y aprobado por el equipo de desarrollo el 2026-03-17.
// Revision cubre: 24 tablas de negocio + refresh_tokens (auth),
// tipos de datos, indices, relaciones, cascadas y politicas RLS.
// Discrepancia resuelta: README_DATABASE.md actualizado para documentar
// que tablas hijas (stocks, quote_items, purchase_order_items, supplier_scores)
// heredan aislamiento de tenant via FK — no requieren tenant_id propio.
// Estado: APROBADO — listo para migracion en HU-013.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL  → nexor_app (non-superuser, subject to RLS) — usado por el servidor Fastify en runtime
  // DIRECT_DATABASE_URL → postgres (superuser, bypassa RLS) — usado por prisma migrate y seeds
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  BRANCH_ADMIN
  AREA_MANAGER
  OPERATIVE
}

enum ModuleName {
  ARI
  NIRA
  KIRA
  AGENDA
  VERA
}

enum Channel {
  WHATSAPP
  GMAIL
}

// =============================================================================
// CORE — tablas compartidas por todos los modulos
// =============================================================================

/// Empresa cliente del SaaS. Nodo raiz de toda la jerarquia.
/// NO tiene tenant_id — es la raiz. Solo el SUPER_ADMIN puede leer todos los registros.
model Tenant {
  id                String  @id @default(cuid()) @db.VarChar(30)
  name              String  @db.VarChar(255)
  slug              String  @unique @db.VarChar(100)
  legalName         String? @map("legal_name") @db.VarChar(255)
  taxId             String? @map("tax_id") @db.VarChar(50)
  isActive          Boolean @default(true) @map("is_active")
  timezone          String  @default("America/Bogota") @db.VarChar(50)
  currency          String  @default("COP") @db.VarChar(3)
  logoUrl           String? @map("logo_url") @db.VarChar(500)
  /// HU-123 — proveedor preferido global del tenant (respaldo cuando el producto no tiene uno).
  defaultSupplierId String? @map("default_supplier_id") @db.VarChar(30)

  /// HU-141 — control de demo y anti-duplicado. `isDemo` es PERMANENTE (no se borra): marca que
  /// la empresa ya conoció el producto en modo demo, aunque la demo expire (`demoEndedAt` en el
  /// pasado) o se convierta en cliente (tenga `subscription`). Junto con `taxId` (NIT) y el correo
  /// del admin sostiene el bloqueo de una segunda demo. La ventana de demo va de `demoStartedAt`
  /// a `demoEndedAt`; una demo vencida se considera expirada/consumida SIN borrar el rastro.
  isDemo        Boolean   @default(false) @map("is_demo")
  demoStartedAt DateTime? @map("demo_started_at") @db.Timestamptz(6)
  demoEndedAt   DateTime? @map("demo_ended_at") @db.Timestamptz(6)
  /// HU-148 — ampliación del cupo de IA de la demo, en mensajes, sobre el base (30). Solo el
  /// SUPER_ADMIN lo aumenta (casos excepcionales, auditado). Cupo efectivo = base + este bonus.
  demoAiQuotaBonus Int    @default(0) @map("demo_ai_quota_bonus")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches              Branch[]
  users                 User[]
  featureFlags          FeatureFlag[]
  integrations          Integration[]
  agentLogs             AgentLog[]
  notifications         Notification[]
  reminders             Reminder[]
  rentals               Rental[]
  clients               Client[]
  clientRatings         ClientRating[]
  pipelineStages        PipelineStage[]
  deals                 Deal[]
  interactions          Interaction[]
  quotes                Quote[]
  products              Product[]
  stockMovements        StockMovement[]
  suppliers             Supplier[]               @relation("TenantSuppliers")
  defaultSupplier       Supplier?                @relation("TenantDefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  supplierRatings       SupplierRating[]
  purchaseOrders        PurchaseOrder[]
  serviceTypes          ServiceType[]
  availability          Availability[]
  appointments          Appointment[]
  blockedDates          BlockedDate[]
  cancelTokens          AppointmentCancelToken[]
  transactions          Transaction[]
  transactionCategories TransactionCategory[]
  costCenters           CostCenter[]
  monthlyBudgets        MonthlyBudget[]
  chatMessages          ChatMessage[]
  bulkUploadLogs        BulkUploadLog[]
  conversations         Conversation[]
  conversationMessages  ConversationMessage[]
  dashboardRollups      DashboardDailyRollup[]
  subscription          Subscription?

  /// HU-141 — soporte del anti-duplicado: búsqueda por NIT/documento estable.
  @@index([taxId])
  @@map("tenants")
}

/// Sucursal de una empresa. El inventario y las integraciones se asignan por sucursal.
model Branch {
  id       String  @id @default(cuid()) @db.VarChar(30)
  tenantId String  @map("tenant_id") @db.VarChar(30)
  name     String  @db.VarChar(255)
  city     String? @db.VarChar(100)
  address  String? @db.VarChar(500)
  phone    String? @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users            User[]
  integrations     Integration[]
  clients          Client[]
  deals            Deal[]
  stocks           Stock[]
  stockMovements   StockMovement[]
  rentals          Rental[]
  purchaseOrders   PurchaseOrder[]
  serviceTypes     ServiceType[]
  availability     Availability[]
  appointments     Appointment[]
  blockedDates     BlockedDate[]
  transactions     Transaction[]
  monthlyBudgets   MonthlyBudget[]
  dashboardRollups DashboardDailyRollup[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("branches")
}

/// Usuarios del sistema de todos los roles y tenants.
/// El email es unico en toda la plataforma.
model User {
  id           String      @id @default(cuid()) @db.VarChar(30)
  tenantId     String      @map("tenant_id") @db.VarChar(30)
  branchId     String?     @map("branch_id") @db.VarChar(30)
  email        String      @unique @db.VarChar(255)
  name         String      @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  role         Role
  module       ModuleName?
  isActive     Boolean     @default(true) @map("is_active")
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  notifications            Notification[]
  reminders                Reminder[]
  rentals                  Rental[]
  assignedClients          Client[]              @relation("ClientAssignee")
  assignedDeals            Deal[]                @relation("DealAssignee")
  interactions             Interaction[]
  quotesCreated            Quote[]               @relation("QuoteCreator")
  purchaseOrdersCreated    PurchaseOrder[]       @relation("POCreator")
  purchaseOrdersApproved   PurchaseOrder[]       @relation("POApprover")
  stockMovements           StockMovement[]
  availabilitySchedules    Availability[]
  professionalAppointments Appointment[]         @relation("AppointmentProfessional")
  serviceProfessionals     ServiceProfessional[]
  refreshTokens            RefreshToken[]
  chatMessages             ChatMessage[]
  assignedConversations    Conversation[]        @relation("ConversationAssignee")
  conversationMessages     ConversationMessage[]
  supplierRatings          SupplierRating[]      @relation("SupplierRatingAuthor")
  clientRatings            ClientRating[]        @relation("ClientRatingAuthor")

  @@index([tenantId])
  @@index([tenantId, role])
  @@index([branchId])
  @@map("users")
}

/// Refresh tokens de sesion. Almacenados como hash SHA-256 del token real.
/// Se eliminan en logout o cuando expiran. Un usuario puede tener varios tokens activos (multidispositivo).
model RefreshToken {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Identidad del equipo NEXOR — operadores de la PLATAFORMA (HU-134).
/// Tabla SEPARADA de `users`: NO tiene tenant_id ni pertenece a ninguna empresa.
/// Su login es propio y su JWT no lleva tenantId. El aislamiento plataforma/cliente
/// queda garantizado por diseño (tablas distintas), no por reglas de aplicación.
/// Solo se accede vía directPrisma (superuser); RLS habilitada sin política =
/// nexor_app no puede leerla ni filtrarla como si fuera un usuario de tenant.
model PlatformAdmin {
  id           String    @id @default(cuid()) @db.VarChar(30)
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

/// Registro INMUTABLE (append-only) de acciones administrativas de la PLATAFORMA (HU-136).
/// Equivalente de agent_logs/stock_movements a nivel de plataforma: QUIÉN (platform_admin),
/// sobre QUÉ cliente (tenant), QUÉ acción, POR QUÉ (reason) y valores relevantes (metadata,
/// p. ej. monto). Solo INSERT — jamás UPDATE/DELETE. Sin FKs a propósito: la historia
/// sobrevive a borrados y no cascada. RLS deny-all (nexor_app no la lee; solo directPrisma):
/// ningún usuario de tenant accede a ella.
model PlatformAuditLog {
  id              String   @id @default(cuid()) @db.VarChar(30)
  platformAdminId String   @map("platform_admin_id") @db.VarChar(30)
  /// Tenant afectado (null en acciones sin tenant asociado).
  tenantId        String?  @map("tenant_id") @db.VarChar(30)
  /// Acción canónica: tenant.create | tenant.activate | tenant.deactivate |
  /// subscription.update | module.enable | module.disable | tenant.impersonate |
  /// channel.connect | channel.disconnect.
  action          String   @db.VarChar(60)
  /// Motivo — OBLIGATORIO en acciones sensibles (suscripción, conexión de canales).
  reason          String?  @db.Text
  /// Valores relevantes (monto, módulo, canal, antes/después, email del actor, etc.).
  metadata        Json     @default("{}") @db.JsonB
  ip              String?  @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([platformAdminId])
  @@map("platform_audit_logs")
}

/// Suscripción de un cliente (tenant) — gestión MANUAL (HU-138). Sin pasarela de cobro.
/// Pertenece al mundo de la PLATAFORMA: RLS deny-all (ningún user de tenant la ve).
/// `status` se mantiene coherente con `tenants.is_active`: cancelar → is_active=false
/// (bloquea el acceso vía tenantHook); activar → is_active=true.
model Subscription {
  id          String    @id @default(cuid()) @db.VarChar(30)
  tenantId    String    @unique @map("tenant_id") @db.VarChar(30)
  /// Monto mensual que paga el cliente (gestión manual).
  amount      Decimal   @default(0) @db.Decimal(15, 2)
  currency    String    @default("COP") @db.VarChar(3)
  /// active | cancelled
  status      String    @default("active") @db.VarChar(20)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// HU-141 — fecha de FIN de suscripción (fin del periodo pagado/contratado). Distinta de
  /// `cancelledAt` (momento de la cancelación): `endsAt` es el término previsto. NULL = sin fin
  /// definido (suscripción abierta). Soporta el estado "ya fue cliente" del anti-duplicado.
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Modulos activos por tenant. Se crea un registro por modulo al crear el tenant.
model FeatureFlag {
  id       String     @id @default(cuid()) @db.VarChar(30)
  tenantId String     @map("tenant_id") @db.VarChar(30)
  module   ModuleName
  enabled  Boolean    @default(false)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@map("feature_flags")
}

/// Tokens y configuracion de integraciones externas (WhatsApp, Gmail).
/// token_encrypted NUNCA se devuelve en responses de la API.
model Integration {
  id             String    @id @default(cuid()) @db.VarChar(30)
  tenantId       String    @map("tenant_id") @db.VarChar(30)
  branchId       String?   @map("branch_id") @db.VarChar(30)
  channel        Channel
  identifier     String    @db.VarChar(255)
  tokenEncrypted String?   @map("token_encrypted") @db.Text
  metadata       Json?     @db.JsonB
  isActive       Boolean   @default(false) @map("is_active")
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([channel, identifier])
  @@map("integrations")
}

/// Registro INMUTABLE de cada accion tomada por los agentes de IA.
/// APPEND-ONLY: nunca se actualiza ni elimina un registro.
model AgentLog {
  id           String     @id @default(cuid()) @db.VarChar(30)
  tenantId     String     @map("tenant_id") @db.VarChar(30)
  module       ModuleName
  channel      String     @db.VarChar(50)
  inputMessage String     @map("input_message") @db.Text
  reply        String?    @db.Text
  toolsUsed    String[]   @default([]) @map("tools_used")
  toolDetails  Json       @map("tool_details") @db.JsonB
  turnCount    Int        @default(1) @map("turn_count")
  durationMs   Int?       @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, module])
  @@index([createdAt(sort: Desc)])
  @@map("agent_logs")
}

/// Notificaciones in-app por usuario. Generadas por el sistema, jobs y agentes de IA.
model Notification {
  id       String      @id @default(cuid()) @db.VarChar(30)
  tenantId String      @map("tenant_id") @db.VarChar(30)
  userId   String      @map("user_id") @db.VarChar(30)
  module   ModuleName?
  type     String      @db.VarChar(50)
  title    String      @db.VarChar(255)
  message  String      @db.Text
  link     String?     @db.VarChar(500)
  isRead   Boolean     @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

/// HU-156 — Recordatorio UNIVERSAL por usuario/tenant. Sirve para cualquier cosa (cita, cliente,
/// venta, compra, o libre). Un job dispara `remind_at` y genera una Notification; según `recurrence`
/// se reprograma (`remind_at` avanza) o se desactiva. `alert_level` es visual (color) por ahora.
model Reminder {
  id          String    @id @default(cuid()) @db.VarChar(30)
  tenantId    String    @map("tenant_id") @db.VarChar(30)
  userId      String    @map("user_id") @db.VarChar(30)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  /// Próxima hora de disparo (para recurrentes avanza tras cada disparo).
  remindAt    DateTime  @map("remind_at") @db.Timestamptz(6)
  /// normal | urgent | critical — solo visual (color/prioridad).
  alertLevel  String    @default("normal") @map("alert_level") @db.VarChar(20)
  /// none | hourly | daily | weekly | monthly.
  recurrence  String    @default("none") @db.VarChar(20)
  /// Asociación opcional: appointment | client | deal | purchase_order | null (libre).
  relatedType String?   @map("related_type") @db.VarChar(30)
  relatedId   String?   @map("related_id") @db.VarChar(30)
  isActive    Boolean   @default(true) @map("is_active")
  /// pending | done (HU-157). Un recordatorio pendiente no se puede eliminar; primero se marca hecho.
  status      String    @default("pending") @db.VarChar(20)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  lastFiredAt DateTime? @map("last_fired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([isActive, remindAt])
  @@map("reminders")
}

// =============================================================================
// MODULO ARI — Ventas y CRM
// =============================================================================

/// Clientes y prospectos. Puede existir aunque nunca haya comprado (lead).
model Client {
  id            String   @id @default(cuid()) @db.VarChar(30)
  tenantId      String   @map("tenant_id") @db.VarChar(30)
  name          String   @db.VarChar(255)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  whatsappId    String?  @map("whatsapp_id") @db.VarChar(50)
  company       String?  @db.VarChar(255)
  taxId         String?  @map("tax_id") @db.VarChar(50)
  address       String?  @db.VarChar(500)
  city          String?  @db.VarChar(100)
  source        String?  @db.VarChar(50)
  tags          String[] @default([])
  notes         String?  @db.Text
  assignedTo    String?  @map("assigned_to") @db.VarChar(30)
  branchId      String?  @map("branch_id") @db.VarChar(30)
  isActive      Boolean  @default(true) @map("is_active")
  /// HU-154 — "Consumidor final": cliente genérico ÚNICO por tenant (un solo registro con is_generic=true,
  /// garantizado por índice único parcial). Se comporta como cualquier cliente; no se borra ni duplica.
  isGeneric     Boolean  @default(false) @map("is_generic")
  /// HU-124 — cliente favorito + descuento manual preferente (informativo: no dispara envíos).
  isFavorite    Boolean  @default(false) @map("is_favorite")
  /// 'percent' (0-100) | 'amount' (monto fijo) | null si no hay descuento.
  discountType  String?  @map("discount_type") @db.VarChar(10)
  discountValue Decimal? @map("discount_value") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser User?          @relation("ClientAssignee", fields: [assignedTo], references: [id])
  branch       Branch?        @relation(fields: [branchId], references: [id])
  deals        Deal[]
  interactions Interaction[]
  quotes       Quote[]
  appointments Appointment[]
  ratings      ClientRating[]
  rentals      Rental[]

  @@index([tenantId])
  @@index([tenantId, assignedTo])
  @@index([whatsappId])
  @@index([tenantId, isActive])
  @@index([tenantId, isFavorite])
  @@map("clients")
}

/// Etapas configurables del pipeline de ventas por tenant.
model PipelineStage {
  id          String  @id @default(cuid()) @db.VarChar(30)
  tenantId    String  @map("tenant_id") @db.VarChar(30)
  name        String  @db.VarChar(100)
  order       Int
  color       String? @db.VarChar(7)
  isFinalWon  Boolean @default(false) @map("is_final_won")
  isFinalLost Boolean @default(false) @map("is_final_lost")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([tenantId, order])
  @@map("pipeline_stages")
}

/// Oportunidades de venta en el pipeline.
model Deal {
  id            String    @id @default(cuid()) @db.VarChar(30)
  tenantId      String    @map("tenant_id") @db.VarChar(30)
  clientId      String    @map("client_id") @db.VarChar(30)
  stageId       String    @map("stage_id") @db.VarChar(30)
  assignedTo    String?   @map("assigned_to") @db.VarChar(30)
  branchId      String?   @map("branch_id") @db.VarChar(30)
  title         String    @db.VarChar(255)
  value         Decimal?  @db.Decimal(15, 2)
  probability   Int?
  expectedClose DateTime? @map("expected_close") @db.Date
  lostReason    String?   @map("lost_reason") @db.Text
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id])
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  assignedUser User?         @relation("DealAssignee", fields: [assignedTo], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  interactions Interaction[]
  quotes       Quote[]
  clientRating ClientRating?

  @@index([tenantId, stageId])
  @@index([tenantId, assignedTo])
  @@index([clientId])
  @@map("deals")
}

/// Historial de comunicaciones con cada cliente.
model Interaction {
  id        String  @id @default(cuid()) @db.VarChar(30)
  tenantId  String  @map("tenant_id") @db.VarChar(30)
  clientId  String  @map("client_id") @db.VarChar(30)
  dealId    String? @map("deal_id") @db.VarChar(30)
  userId    String? @map("user_id") @db.VarChar(30)
  type      String  @db.VarChar(50)
  direction String  @db.VarChar(10)
  content   String  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])
  deal   Deal?  @relation(fields: [dealId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, clientId])
  @@index([createdAt(sort: Desc)])
  @@map("interactions")
}

/// Cotizaciones generadas para los clientes.
model Quote {
  id          String    @id @default(cuid()) @db.VarChar(30)
  tenantId    String    @map("tenant_id") @db.VarChar(30)
  clientId    String    @map("client_id") @db.VarChar(30)
  dealId      String?   @map("deal_id") @db.VarChar(30)
  createdBy   String    @map("created_by") @db.VarChar(30)
  quoteNumber String    @map("quote_number") @db.VarChar(50)
  status      String    @default("draft") @db.VarChar(30)
  subtotal    Decimal   @default(0) @db.Decimal(15, 2)
  discount    Decimal   @default(0) @db.Decimal(15, 2)
  tax         Decimal   @default(0) @db.Decimal(15, 2)
  total       Decimal   @default(0) @db.Decimal(15, 2)
  validUntil  DateTime? @map("valid_until") @db.Date
  notes       String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client      @relation(fields: [clientId], references: [id])
  deal    Deal?       @relation(fields: [dealId], references: [id])
  creator User        @relation("QuoteCreator", fields: [createdBy], references: [id])
  items   QuoteItem[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@map("quotes")
}

/// Lineas de cada cotizacion.
model QuoteItem {
  id          String  @id @default(cuid()) @db.VarChar(30)
  quoteId     String  @map("quote_id") @db.VarChar(30)
  productId   String? @map("product_id") @db.VarChar(30)
  description String  @db.VarChar(500)
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  discountPct Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  total       Decimal @db.Decimal(15, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

/// Calificacion INTERNA del equipo de ventas al cliente, al cerrar la venta (HU-126).
/// Disparador (decision PO): deal en etapa GANADA (isFinalWon). Escala 1-5. Una por deal.
/// NO es el CSAT del cliente hacia la empresa (eso es encuesta saliente, va aparte).
model ClientRating {
  id       String  @id @default(cuid()) @db.VarChar(30)
  tenantId String  @map("tenant_id") @db.VarChar(30)
  clientId String  @map("client_id") @db.VarChar(30)
  dealId   String? @unique @map("deal_id") @db.VarChar(30)
  rating   Int     @db.SmallInt
  notes    String? @db.Text
  ratedBy  String  @map("rated_by") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal        Deal?  @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ratedByUser User   @relation("ClientRatingAuthor", fields: [ratedBy], references: [id])

  @@index([tenantId, clientId])
  @@index([createdAt(sort: Desc)])
  @@map("client_ratings")
}

// =============================================================================
// MODULO KIRA — Inventario
// =============================================================================

/// Catalogo global de productos por tenant. El stock es por sucursal.
model Product {
  id                  String   @id @default(cuid()) @db.VarChar(30)
  tenantId            String   @map("tenant_id") @db.VarChar(30)
  sku                 String   @db.VarChar(100)
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  category            String?  @db.VarChar(100)
  unit                String   @default("unidad") @db.VarChar(50)
  salePrice           Decimal? @map("sale_price") @db.Decimal(15, 2)
  costPrice           Decimal? @map("cost_price") @db.Decimal(15, 2)
  minStock            Int      @default(0) @map("min_stock")
  maxStock            Int?     @map("max_stock")
  abcClass            String?  @map("abc_class") @db.VarChar(1)
  /// HU-123 — proveedor preferido para reabastecer este producto (opcional).
  preferredSupplierId String?  @map("preferred_supplier_id") @db.VarChar(30)
  /// HU-158 — el producto se puede vender (salida definitiva). Default true (retrocompat).
  isSellable          Boolean  @default(true)  @map("is_sellable")
  /// HU-158 — el producto se puede alquilar (salida temporal). Default false.
  isRentable          Boolean  @default(false) @map("is_rentable")
  /// HU-158 — tarifa de alquiler (por unidad/periodo). Opcional; la usa el módulo de alquiler.
  rentalPrice         Decimal? @map("rental_price") @db.Decimal(15, 2)
  isActive            Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks             Stock[]
  stockMovements     StockMovement[]
  quoteItems         QuoteItem[]
  purchaseOrderItems PurchaseOrderItem[]
  rentals            Rental[]
  preferredSupplier  Supplier?           @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@index([tenantId, abcClass])
  @@index([preferredSupplierId])
  @@map("products")
}

/// Stock actual de cada producto en cada sucursal. Fuente de verdad del inventario.
/// quantity NUNCA puede ser negativo — validar en la capa de servicio.
model Stock {
  id        String  @id @default(cuid()) @db.VarChar(30)
  productId String  @map("product_id") @db.VarChar(30)
  branchId  String  @map("branch_id") @db.VarChar(30)
  /// Stock TOTAL en la sucursal (HU-158: incluye lo alquilado; el alquiler no lo reduce).
  quantity  Decimal @default(0) @db.Decimal(10, 2)
  /// HU-158 — unidades alquiladas actualmente (salida temporal). Disponible = quantity − rentedQuantity.
  /// Caché consistente del total de alquileres activos (fuente de verdad: tabla `rentals`).
  rentedQuantity Decimal @default(0) @map("rented_quantity") @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("stocks")
}

/// HU-158 — Alquileres: salida TEMPORAL de stock. No reduce el total, reduce el disponible.
/// Fuente de verdad de "cuánto está alquilado"; `stocks.rentedQuantity` es su caché.
/// Base del módulo de alquiler (HU-159–163). Append-friendly: un alquiler se cierra con `returned`.
model Rental {
  id         String    @id @default(cuid()) @db.VarChar(30)
  tenantId   String    @map("tenant_id") @db.VarChar(30)
  productId  String    @map("product_id") @db.VarChar(30)
  branchId   String    @map("branch_id") @db.VarChar(30)
  /// A quién se le alquiló (opcional en el habilitador; lo usa el flujo de HU-159).
  clientId   String?   @map("client_id") @db.VarChar(30)
  /// Quién registró el alquiler.
  userId     String?   @map("user_id") @db.VarChar(30)
  quantity   Decimal   @db.Decimal(10, 2)
  /// active | returned. Solo los `active` cuentan como alquilado (reducen el disponible).
  status     String    @default("active") @db.VarChar(20)
  /// HU-159 — cobro: `fixed` (monto fijo) | `daily` (tarifa por día). El total se resuelve en HU-160.
  chargeType String    @default("fixed") @map("charge_type") @db.VarChar(20)
  /// Monto fijo pactado (cuando chargeType='fixed').
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(15, 2)
  /// Tarifa por día (cuando chargeType='daily').
  dailyRate   Decimal? @map("daily_rate") @db.Decimal(15, 2)
  /// Depósito dejado por el cliente. NO es ingreso todavía (se resuelve en la devolución — HU-162).
  deposit     Decimal  @default(0) @db.Decimal(15, 2)
  rentedAt   DateTime  @default(now()) @map("rented_at") @db.Timestamptz(6)
  /// Fecha de retorno (fija) o estimada (por días).
  dueAt      DateTime? @map("due_at") @db.Timestamptz(6)
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(6)
  notes      String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, productId, branchId, status])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("rentals")
}

/// Historial INMUTABLE de cada cambio en el inventario.
/// APPEND-ONLY: nunca se modifica ni elimina un movimiento.
model StockMovement {
  id              String    @id @default(cuid()) @db.VarChar(30)
  tenantId        String    @map("tenant_id") @db.VarChar(30)
  productId       String    @map("product_id") @db.VarChar(30)
  branchId        String    @map("branch_id") @db.VarChar(30)
  userId          String?   @map("user_id") @db.VarChar(30)
  /// CÓMO se movió: entrada | salida | ajuste (normalizado en minúsculas — HU-128).
  type            String    @db.VarChar(30)
  /// POR QUÉ se movió (HU-128, OBLIGATORIO): compra | venta | devolucion | ajuste | traslado | desconocido.
  /// DEFAULT 'desconocido' = red de seguridad (nunca vacío); el código siempre pone el motivo real.
  reason          String    @default("desconocido") @db.VarChar(20)
  quantity        Decimal   @db.Decimal(10, 2)
  quantityBefore  Decimal   @map("quantity_before") @db.Decimal(10, 2)
  quantityAfter   Decimal   @map("quantity_after") @db.Decimal(10, 2)
  referenceType   String?   @map("reference_type") @db.VarChar(50)
  referenceId     String?   @map("reference_id") @db.VarChar(30)
  /// HU-128 — en movimientos de VENTA se congela el precio del momento (margen histórico exacto).
  salePriceFrozen Decimal?  @map("sale_price_frozen") @db.Decimal(15, 2)
  costPriceFrozen Decimal?  @map("cost_price_frozen") @db.Decimal(15, 2)
  lotNumber       String?   @map("lot_number") @db.VarChar(100)
  expiryDate      DateTime? @map("expiry_date") @db.Date
  notes           String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, productId])
  @@index([branchId])
  @@index([createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([tenantId, reason])
  @@map("stock_movements")
}

// =============================================================================
// MODULO NIRA — Compras
// =============================================================================

/// Proveedores de la empresa.
model Supplier {
  id           String  @id @default(cuid()) @db.VarChar(30)
  tenantId     String  @map("tenant_id") @db.VarChar(30)
  name         String  @db.VarChar(255)
  contactName  String? @map("contact_name") @db.VarChar(255)
  email        String? @db.VarChar(255)
  phone        String? @db.VarChar(20)
  taxId        String? @map("tax_id") @db.VarChar(50)
  address      String? @db.VarChar(500)
  city         String? @db.VarChar(100)
  paymentTerms Int?    @map("payment_terms")
  notes        String? @db.Text
  isActive     Boolean @default(true) @map("is_active")
  /// HU-154 — "Proveedor ocasional": proveedor genérico ÚNICO por tenant (un solo registro con
  /// is_generic=true, garantizado por índice único parcial). Se comporta como cualquier proveedor.
  isGeneric    Boolean @default(false) @map("is_generic")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant           @relation("TenantSuppliers", fields: [tenantId], references: [id], onDelete: Cascade)
  score                SupplierScore?
  ratings              SupplierRating[]
  purchaseOrders       PurchaseOrder[]
  preferredForProducts Product[]        @relation("ProductPreferredSupplier")
  defaultForTenants    Tenant[]         @relation("TenantDefaultSupplier")

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

/// Puntuacion calculada automaticamente para cada proveedor (1 a 1 con Supplier).
/// HU-125 — los ejes son NULLABLE: NULL = "sin datos" (no engañoso) en vez de un valor por defecto.
///   priceScore    → objetivo, del histórico de precios (NULL si no hay compras recibidas)
///   deliveryScore → de las calificaciones manuales al recibir (NULL si no hay calificaciones)
///   qualityScore  → de las calificaciones manuales al recibir (NULL si no hay calificaciones)
///   overallScore  → promedio de los ejes CON datos (NULL si ninguno tiene datos)
model SupplierScore {
  id               String   @id @default(cuid()) @db.VarChar(30)
  supplierId       String   @unique @map("supplier_id") @db.VarChar(30)
  priceScore       Decimal? @map("price_score") @db.Decimal(4, 2)
  deliveryScore    Decimal? @map("delivery_score") @db.Decimal(4, 2)
  qualityScore     Decimal? @map("quality_score") @db.Decimal(4, 2)
  overallScore     Decimal? @map("overall_score") @db.Decimal(4, 2)
  totalOrders      Int      @default(0) @map("total_orders")
  onTimeDeliveries Int      @default(0) @map("on_time_deliveries")
  ratingsCount     Int      @default(0) @map("ratings_count")

  calculatedAt DateTime @map("calculated_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_scores")
}

/// Calificacion manual de un proveedor al recibir una OC (HU-125).
/// Fuente explicita de los ejes Entrega y Calidad del score. Escala 1-5.
/// Una calificacion por OC (purchase_order_id unico). Calificar es opcional.
model SupplierRating {
  id              String  @id @default(cuid()) @db.VarChar(30)
  tenantId        String  @map("tenant_id") @db.VarChar(30)
  supplierId      String  @map("supplier_id") @db.VarChar(30)
  purchaseOrderId String? @unique @map("purchase_order_id") @db.VarChar(30)
  deliveryRating  Int     @map("delivery_rating") @db.SmallInt
  qualityRating   Int     @map("quality_rating") @db.SmallInt
  notes           String? @db.Text
  ratedBy         String  @map("rated_by") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  ratedByUser   User           @relation("SupplierRatingAuthor", fields: [ratedBy], references: [id])

  @@index([tenantId, supplierId])
  @@index([createdAt(sort: Desc)])
  @@map("supplier_ratings")
}

/// Ordenes de compra emitidas a los proveedores.
model PurchaseOrder {
  id               String    @id @default(cuid()) @db.VarChar(30)
  tenantId         String    @map("tenant_id") @db.VarChar(30)
  supplierId       String?   @map("supplier_id") @db.VarChar(30)
  branchId         String?   @map("branch_id") @db.VarChar(30)
  createdBy        String    @map("created_by") @db.VarChar(30)
  approvedBy       String?   @map("approved_by") @db.VarChar(30)
  orderNumber      String    @map("order_number") @db.VarChar(50)
  status           String    @default("draft") @db.VarChar(30)
  subtotal         Decimal   @default(0) @db.Decimal(15, 2)
  tax              Decimal   @default(0) @db.Decimal(15, 2)
  total            Decimal   @default(0) @db.Decimal(15, 2)
  expectedDelivery DateTime? @map("expected_delivery") @db.Date
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)
  notes            String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  branch   Branch?             @relation(fields: [branchId], references: [id])
  creator  User                @relation("POCreator", fields: [createdBy], references: [id])
  approver User?               @relation("POApprover", fields: [approvedBy], references: [id])
  items    PurchaseOrderItem[]
  rating   SupplierRating?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

/// Lineas de cada orden de compra.
model PurchaseOrderItem {
  id               String  @id @default(cuid()) @db.VarChar(30)
  purchaseOrderId  String  @map("purchase_order_id") @db.VarChar(30)
  productId        String  @map("product_id") @db.VarChar(30)
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(10, 2)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(10, 2)
  unitCost         Decimal @map("unit_cost") @db.Decimal(15, 2)
  total            Decimal @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// =============================================================================
// MODULO AGENDA — Agendamiento
// =============================================================================

/// Tipos de servicios o citas que ofrece la empresa.
model ServiceType {
  id              String   @id @default(cuid()) @db.VarChar(30)
  tenantId        String   @map("tenant_id") @db.VarChar(30)
  branchId        String?  @map("branch_id") @db.VarChar(30)
  name            String   @db.VarChar(255)
  description     String?  @db.VarChar(500)
  durationMinutes Int      @default(30) @map("duration_minutes")
  price           Decimal? @db.Decimal(15, 2)
  color           String?  @db.VarChar(7)
  isActive        Boolean  @default(true) @map("is_active")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?               @relation(fields: [branchId], references: [id])
  appointments  Appointment[]
  professionals ServiceProfessional[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, isActive])
  @@map("service_types")
}

/// Profesionales (usuarios) que pueden realizar un servicio.
/// Tabla puente ServiceType ↔ User.
model ServiceProfessional {
  serviceTypeId String @map("service_type_id") @db.VarChar(30)
  userId        String @map("user_id") @db.VarChar(30)

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serviceTypeId, userId])
  @@index([userId])
  @@map("service_professionals")
}

/// Fechas bloqueadas por sucursal (festivos, cierres especiales).
/// Cuando una fecha está bloqueada no se generan slots para esa sucursal ese día.
model BlockedDate {
  id       String   @id @default(cuid()) @db.VarChar(30)
  tenantId String   @map("tenant_id") @db.VarChar(30)
  branchId String?  @map("branch_id") @db.VarChar(30)
  date     DateTime @db.Date
  reason   String?  @db.VarChar(255)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, date])
  @@index([tenantId, date])
  @@map("blocked_dates")
}

/// Horarios de disponibilidad por sucursal o profesional.
model Availability {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tenantId  String   @map("tenant_id") @db.VarChar(30)
  branchId  String?  @map("branch_id") @db.VarChar(30)
  userId    String?  @map("user_id") @db.VarChar(30)
  dayOfWeek Int      @map("day_of_week")
  startTime DateTime @map("start_time") @db.Time(6)
  endTime   DateTime @map("end_time") @db.Time(6)
  isActive  Boolean  @default(true) @map("is_active")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, branchId, dayOfWeek])
  @@map("availability")
}

/// Citas agendadas. El agente de IA puede crearlas desde WhatsApp.
model Appointment {
  id             String   @id @default(cuid()) @db.VarChar(30)
  tenantId       String   @map("tenant_id") @db.VarChar(30)
  branchId       String   @map("branch_id") @db.VarChar(30)
  clientId       String?  @map("client_id") @db.VarChar(30)
  serviceTypeId  String?  @map("service_type_id") @db.VarChar(30)
  professionalId String?  @map("professional_id") @db.VarChar(30)
  clientName     String   @map("client_name") @db.VarChar(255)
  clientPhone    String?  @map("client_phone") @db.VarChar(20)
  clientEmail    String?  @map("client_email") @db.VarChar(255)
  startAt        DateTime @map("start_at") @db.Timestamptz(6)
  endAt          DateTime @map("end_at") @db.Timestamptz(6)
  status         String   @default("scheduled") @db.VarChar(30)
  notes          String?  @db.Text
  channel        String   @default("manual") @db.VarChar(50)
  reminderSent   Boolean  @default(false) @map("reminder_sent")
  createdByAgent Boolean  @default(false) @map("created_by_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch                   @relation(fields: [branchId], references: [id])
  client       Client?                  @relation(fields: [clientId], references: [id])
  serviceType  ServiceType?             @relation(fields: [serviceTypeId], references: [id])
  professional User?                    @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  cancelTokens AppointmentCancelToken[]

  @@index([tenantId, branchId, startAt])
  @@index([tenantId, startAt])
  @@index([tenantId, status])
  @@index([professionalId, startAt])
  @@map("appointments")
}

/// Token de un solo uso para cancelar una cita desde el email de recordatorio sin autenticarse.
model AppointmentCancelToken {
  id            String    @id @default(cuid()) @db.VarChar(30)
  token         String    @unique @db.VarChar(64)
  tenantId      String    @map("tenant_id") @db.VarChar(30)
  appointmentId String    @map("appointment_id") @db.VarChar(30)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_cancel_tokens")
}

// =============================================================================
// MODULO VERA — Finanzas
// =============================================================================

/// Registro financiero de movimientos de dinero.
/// isManual=true → creado por usuario; isManual=false → generado por ARI, NIRA o AGENDA.
/// Solo las transacciones manuales pueden editarse o eliminarse.
model Transaction {
  id                String   @id @default(cuid()) @db.VarChar(30)
  tenantId          String   @map("tenant_id") @db.VarChar(30)
  branchId          String?  @map("branch_id") @db.VarChar(30)
  categoryId        String?  @map("category_id") @db.VarChar(30)
  costCenterId      String?  @map("cost_center_id") @db.VarChar(30)
  isManual          Boolean  @default(false) @map("is_manual")
  type              String   @db.VarChar(20)
  amount            Decimal  @db.Decimal(15, 2)
  currency          String   @default("COP") @db.VarChar(3)
  description       String   @db.VarChar(500)
  externalReference String?  @map("external_reference") @db.VarChar(255)
  category          String?  @db.VarChar(100)
  referenceType     String?  @map("reference_type") @db.VarChar(50)
  referenceId       String?  @map("reference_id") @db.VarChar(30)
  date              DateTime @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?              @relation(fields: [branchId], references: [id])
  txCategory TransactionCategory? @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?          @relation(fields: [costCenterId], references: [id])

  @@index([tenantId, date(sort: Desc)])
  @@index([tenantId, type])
  @@index([tenantId, isManual])
  @@index([tenantId, categoryId])
  @@index([referenceType, referenceId])
  @@map("transactions")
}

/// Categoria de clasificacion de transacciones VERA. Configurable por tenant.
/// Las categorias isDefault no pueden eliminarse.
model TransactionCategory {
  id        String  @id @default(cuid()) @db.VarChar(30)
  tenantId  String  @map("tenant_id") @db.VarChar(30)
  name      String  @db.VarChar(100)
  type      String  @db.VarChar(10)
  color     String? @db.VarChar(7)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("transaction_categories")
}

/// Centro de costo para clasificacion financiera interna por area del negocio.
model CostCenter {
  id          String  @id @default(cuid()) @db.VarChar(30)
  tenantId    String  @map("tenant_id") @db.VarChar(30)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("cost_centers")
}

/// Presupuesto mensual de egresos de VERA. Uno por tenant/sucursal/mes.
/// Si no hay presupuesto configurado no se generan alertas.
model MonthlyBudget {
  id       String  @id @default(cuid()) @db.VarChar(30)
  tenantId String  @map("tenant_id") @db.VarChar(30)
  branchId String? @map("branch_id") @db.VarChar(30)
  year     Int
  month    Int
  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("COP") @db.VarChar(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, year, month])
  @@index([tenantId])
  @@map("monthly_budgets")
}

// =============================================================================
// DASHBOARD — rollup diario para gráficos de líneas (HU-127)
// =============================================================================

/// Consolidado DIARIO de métricas del Dashboard, poblado por un job programado.
/// Una fila por (tenant, sucursal, día). branch_id NULL = consolidado del tenant
/// (TENANT_ADMIN); branch_id = sucursal (BRANCH_ADMIN). El job hace delete+insert
/// por (tenant, ventana de días) — por eso no hay UNIQUE, solo índices de lectura.
/// Distinción: purchase_orders_created = OC creadas; purchases_received = OC recibidas.
model DashboardDailyRollup {
  id                    String   @id @default(cuid()) @db.VarChar(30)
  tenantId              String   @map("tenant_id") @db.VarChar(30)
  branchId              String?  @map("branch_id") @db.VarChar(30)
  date                  DateTime @db.Date
  purchasesReceived     Int      @default(0) @map("purchases_received")
  purchasesAmount       Decimal  @default(0) @map("purchases_amount") @db.Decimal(15, 2)
  salesCount            Int      @default(0) @map("sales_count")
  salesAmount           Decimal  @default(0) @map("sales_amount") @db.Decimal(15, 2)
  purchaseOrdersCreated Int      @default(0) @map("purchase_orders_created")
  quotesCreated         Int      @default(0) @map("quotes_created")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, branchId, date])
  @@map("dashboard_daily_rollups")
}

// =============================================================================
// CARGA MASIVA — Auditoría de importaciones en lote
// =============================================================================

/// Registro de auditoría de cada carga masiva de datos (importación Excel).
/// APPEND-ONLY: nunca se modifica ni elimina un registro.
/// status: preview | failed | success
model BulkUploadLog {
  id          String    @id @default(cuid()) @db.VarChar(30)
  tenantId    String    @map("tenant_id") @db.VarChar(30)
  userId      String    @map("user_id") @db.VarChar(30)
  type        String    @db.VarChar(50)
  fileName    String    @map("file_name") @db.VarChar(500)
  fileSize    Int?      @map("file_size")
  rowCount    Int?      @map("row_count")
  recordCount Int       @default(0) @map("record_count")
  status      String    @db.VarChar(20)
  errors      Json?     @db.JsonB
  fileData    Bytes?    @map("file_data")
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([createdAt(sort: Desc)])
  @@map("bulk_upload_logs")
}

/// Historial de conversación del chat interno del dashboard.
/// Un registro por mensaje (user o assistant). Append-only.
model ChatMessage {
  id       String      @id @default(cuid()) @db.VarChar(30)
  tenantId String      @map("tenant_id") @db.VarChar(30)
  userId   String      @map("user_id") @db.VarChar(30)
  /// 'user' = mensaje del empleado, 'assistant' = respuesta del agente
  role     String      @db.VarChar(20)
  content  String      @db.Text
  /// Módulo al que se enrutó el mensaje (solo en mensajes 'user')
  module   ModuleName?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Índice compuesto principal — historial paginado por usuario
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

// =============================================================================
// BANDEJA DE ENTRADA — Conversaciones agrupadas por canal
// =============================================================================

/// Hilo de conversación que agrupa mensajes de un mismo remitente por canal.
/// WhatsApp: mensajes del mismo número en ventana de 24 horas de inactividad.
/// Gmail: mensajes del mismo email sin límite de tiempo.
/// El estado lo actualiza el equipo humano — el agente nunca cambia el status.
model Conversation {
  id               String      @id @default(cuid()) @db.VarChar(30)
  tenantId         String      @map("tenant_id") @db.VarChar(30)
  channel          Channel
  senderIdentifier String      @map("sender_identifier") @db.VarChar(255)
  senderName       String?     @map("sender_name") @db.VarChar(255)
  relatedModule    ModuleName? @map("related_module")
  /// open | replied | resolved | reassigned
  status           String      @default("open") @db.VarChar(20)
  assignedTo       String?     @map("assigned_to") @db.VarChar(30)
  lastMessageAt    DateTime    @map("last_message_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser User?                 @relation("ConversationAssignee", fields: [assignedTo], references: [id])
  messages     ConversationMessage[]

  @@index([tenantId, channel, senderIdentifier])
  @@index([tenantId, status])
  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Mensaje individual dentro de una conversación. APPEND-ONLY.
/// direction: inbound (remitente → sistema) | outbound (sistema → remitente).
/// isFromAgent: true cuando lo generó el AgentRunner; false cuando lo envió un humano.
model ConversationMessage {
  id                String   @id @default(cuid()) @db.VarChar(30)
  conversationId    String   @map("conversation_id") @db.VarChar(30)
  tenantId          String   @map("tenant_id") @db.VarChar(30)
  /// inbound | outbound
  direction         String   @db.VarChar(10)
  content           String   @db.Text
  /// text | image | document
  messageType       String   @default("text") @map("message_type") @db.VarChar(20)
  isFromAgent       Boolean  @default(false) @map("is_from_agent")
  /// userId presente solo cuando direction=outbound y isFromAgent=false
  userId            String?  @map("user_id") @db.VarChar(30)
  /// ID externo del mensaje (wamid de Meta o messageId de Gmail)
  externalMessageId String?  @map("external_message_id") @db.VarChar(255)
  timestamp         DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([conversationId, timestamp(sort: Asc)])
  @@index([tenantId])
  @@index([externalMessageId])
  @@map("conversation_messages")
}
